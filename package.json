{
  "name": "iptuapi",
  "version": "2.1.2",
  "description": "SDK oficial para a IPTU API - Dados de IPTU de São Paulo, Belo Horizonte e Recife",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "iptu",
    "api",
    "são paulo",
    "belo horizonte",
    "recife",
    "imóveis",
    "dados",
    "real estate",
    "property",
    "typescript",
    "sdk"
  ],
  "author": "IPTU API <contato@iptuapi.com.br>",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/iptuapi/iptuapi-js"
  },
  "homepage": "https://iptuapi.com.br",
  "bugs": {
    "url": "https://github.com/iptuapi/iptuapi-js/issues"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.0.16",
    "msw": "^2.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18"
  }
}
